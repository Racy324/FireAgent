# FireAgent 环境变量示例。
# 复制为 .env 后填写服务密钥；不要把真实 API Key 提交到仓库。

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=fireagent_papers
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=bm25
QDRANT_DENSE_VECTOR_SIZE=1024

TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_TOPIC=general
TAVILY_INCLUDE_ANSWER=true
TAVILY_INCLUDE_RAW_CONTENT=false
TAVILY_INCLUDE_IMAGES=false
TAVILY_TIMEOUT=30
TAVILY_CHUNKS_PER_SOURCE=3

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_TEMPERATURE=0.1
OPENAI_COMPATIBLE_MAX_TOKENS=1200
OPENAI_COMPATIBLE_TIMEOUT=60
ENABLE_LLM_ANSWER=true
LLM_PROVIDER=openai_compatible

# PDF 解析器：pdfplumber 稳定轻量；mineru 可读取版面、表格和图注结构。
PDF_PARSER=pdfplumber
MINERU_OUTPUT_DIR=data/parsed/mineru
MINERU_BACKEND=pipeline
MINERU_MODEL_SOURCE=local
MINERU_TIMEOUT=1800
MINERU_KEEP_OUTPUT=true
MINERU_CLI_PATH=mineru

OLLAMA_BASE_URL=http://localhost:11434

# 默认示例使用 Ollama 提供 embedding。
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL_NAME=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT=60
EMBEDDING_BATCH_SIZE=32

# 默认示例使用 FlagEmbedding 从本地目录加载真正的 cross-encoder reranker。
RERANKER_PROVIDER=flagembedding
RERANKER_MODEL_NAME=models/bge-reranker-v2-m3
RERANKER_BASE_URL=http://localhost:11434
RERANKER_TIMEOUT=60
RERANKER_BATCH_SIZE=16
RERANKER_FALLBACK_TO_LEXICAL=true

# 如果要使用本机 Python 模型，可把 EMBEDDING_PROVIDER 改为 sentence_transformers，
# 如果只想用 Ollama 做轻量相似度重排，可把 RERANKER_PROVIDER 改为 ollama。

CHUNK_SIZE=800
CHUNK_OVERLAP=120
PARENT_CHUNK_SIZE=1800

MAX_REWRITE_QUERIES=4
DENSE_TOP_K=30
SPARSE_TOP_K=30
FUSION_TOP_K=50
RERANK_TOP_K=10
DENSE_WEIGHT=0.65
SPARSE_WEIGHT=0.35
RRF_K=60
CONTEXT_MAX_CHARS=6000
CONTEXT_MAX_EVIDENCE_CHARS=1200
SUFFICIENCY_MIN_SCORE=0.18
SUFFICIENCY_MIN_EVIDENCE=2
SUFFICIENCY_MIN_TERM_COVERAGE=0.30

ENABLE_WEB_FALLBACK=true

# RAG 评测默认配置。
EVAL_DATASET_PATH=data/eval/fireagent_eval_sample.jsonl
EVAL_OUTPUT_DIR=data/eval/runs
EVAL_DEFAULT_MODE=manual
EVAL_FAIL_UNDER=

APP_ENVIRONMENT=local
LOG_LEVEL=INFO
